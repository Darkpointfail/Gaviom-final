# Stripe — required for checkout (Vercel → Settings → Environment Variables)
STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME_NEVER_EXPOSE_THIS
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Supabase — optional, stores completed orders from Stripe webhook
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Email provider (optional)
SENDGRID_API_KEY=SG.REPLACE_ME

# Google Search Console
GOOGLE_SITE_VERIFICATION=REPLACE_WITH_YOUR_CODE
