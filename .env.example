# Copy to .env.local for local sign-in / signup / OTP (never commit .env.local)
# Pull from Vercel:  vercel env pull .env.local

SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=your_resend_key
AUTH_CONFIRM_FROM=Gaviom <noreply@getgaviom.com>

# Optional
# EMAIL_VERIFICATION_PEPPER=
# AUTH_CONFIRM_ORIGIN=http://localhost:3001
# CREATOR_APPLICATION_TO=info@getgaviom.com,tomcharlesgrosse@gmail.com
# CREATOR_APPLICATION_FROM=Gaviom Creators <noreply@getgaviom.com>
# CREATOR_APPLICATION_ORIGIN=https://gaviom.com
