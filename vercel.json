{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/gaviom-favicon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://*.googletagmanager.com https://www.google.com https://stats.g.doubleclick.net https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.gaviom.com" }],
      "destination": "https://gaviom.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "has": [{ "type": "query", "key": "page" }],
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/404.html",
      "statusCode": 404
    },
    {
      "source": "/blog/live-sweepstakes-draws-youtube.html",
      "destination": "/blog/live-sweepstakes-draws-tiktok.html",
      "statusCode": 301
    },
    {
      "source": "/corporate.html",
      "destination": "/business",
      "statusCode": 301
    },
    {
      "source": "/blog/sweepstakes-vs-contests-vs-lotteries.html",
      "destination": "/blog/sweepstakes-lottery-contest-difference.html",
      "statusCode": 301
    },
    {
      "source": "/blog/online-sweepstakes-explained.html",
      "destination": "/blog/how-online-sweepstakes-work-us.html",
      "statusCode": 301
    },
    {
      "source": "/blog/best-legitimate-travel-giveaways-2025.html",
      "destination": "/blog/best-legitimate-travel-giveaways-2026.html",
      "statusCode": 301
    },
    {
      "source": "/blog/how-to-enter-travel-sweepstakes-win.html",
      "destination": "/blog/how-to-enter-travel-sweepstakes-and-win.html",
      "statusCode": 301
    },
    {
      "source": "/blog/step-by-step-enter-win-travel-contest.html",
      "destination": "/blog/how-to-enter-travel-sweepstakes-and-win.html",
      "statusCode": 301
    },
    {
      "source": "/blog/vacation-sweepstakes-guide-beginners.html",
      "destination": "/blog/vacation-sweepstakes-beginners-guide.html",
      "statusCode": 301
    },
    {
      "source": "/blog/how-to-spot-fake-travel-giveaway.html",
      "destination": "/blog/spot-fake-travel-giveaway-vs-real.html",
      "statusCode": 301
    },
    {
      "source": "/blog/free-flight-hotel-giveaway-real.html",
      "destination": "/blog/free-flight-and-hotel-giveaway-legit.html",
      "statusCode": 301
    },
    {
      "source": "/blog/best-travel-sweepstakes-today.html",
      "destination": "/blog/best-legitimate-travel-giveaways-2026.html",
      "statusCode": 301
    },
    {
      "source": "/blog/win-a-free-vacation-this-year.html",
      "destination": "/blog/ultimate-guide-vacation-sweepstakes-us.html",
      "statusCode": 301
    },
    {
      "source": "/blog/are-travel-contests-real.html",
      "destination": "/blog/are-travel-giveaways-real-legit.html",
      "statusCode": 301
    },
    {
      "source": "/blog/beginners-guide-sweepstakes-usa.html",
      "destination": "/blog/gaviom-sweepstakes-guide-enter-win-online.html",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
